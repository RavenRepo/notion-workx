{
  "name": "worx",
  "version": "1.0.0",
  "description": "Generate Notion Worker tools from OpenAPI specs",
  "main": "dist/cli/index.js",
  "bin": {
    "worx": "dist/cli/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && cp -r src/generator/templates dist/generator/templates",
    "dev": "tsx src/cli/index.ts",
    "generate": "tsx src/cli/index.ts generate",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openapi",
    "notion",
    "workers",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@readme/openapi-parser": "^6.1.1",
    "commander": "^14.0.3",
    "handlebars": "^4.7.9",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
